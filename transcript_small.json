{
  "duration": 1823.7013125,
  "segments": [
    {
      "start": 3.47,
      "end": 7.47,
      "text": "俺結構やんちゃなんで ギター弾きながら 結構離れちゃったりしてね"
    },
    {
      "start": 7.47,
      "end": 11.47,
      "text": "もしかしたら音が大きくなったり 小さくなったりするかもしれないんですけど"
    },
    {
      "start": 11.47,
      "end": 14.47,
      "text": "それも含めてライブということで 楽しんでいきましょう"
    },
    {
      "start": 14.47,
      "end": 23.81,
      "text": "よろしくお願いします 下北沢ログだ 楽しんでこうぜ"
    },
    {
      "start": 23.81,
      "end": 29.1,
      "text": "良かったら手としてください"
    },
    {
      "start": 29.1,
      "end": 34.33,
      "text": "下町の寝音が伸びて"
    },
    {
      "start": 34.33,
      "end": 37.33,
      "text": "あっちらこっちら散らばる"
    },
    {
      "start": 37.33,
      "end": 41.33,
      "text": "寂しさも浴びてく"
    },
    {
      "start": 41.74,
      "end": 43.74,
      "text": "いつもは嫌いな"
    },
    {
      "start": 43.74,
      "end": 46.74,
      "text": "明日の人たちが"
    },
    {
      "start": 46.74,
      "end": 50.87,
      "text": "かわいく見えてきたり"
    },
    {
      "start": 50.87,
      "end": 54.87,
      "text": "どうしちゃった右左"
    },
    {
      "start": 54.87,
      "end": 61.22,
      "text": "借りそうめの温もりに 涙は寝ないな"
    },
    {
      "start": 61.22,
      "end": 65.42,
      "text": "こんなことになるのなら"
    },
    {
      "start": 65.42,
      "end": 71.42,
      "text": "冷たいままで良かったのに"
    },
    {
      "start": 71.42,
      "end": 76.74,
      "text": "ハニハニ 蜂蜜みたいな"
    },
    {
      "start": 76.74,
      "end": 80.22,
      "text": "窓のみにまみれても"
    },
    {
      "start": 80.22,
      "end": 86.22,
      "text": "肌に残った 針がチクチクしてる"
    },
    {
      "start": 86.22,
      "end": 93.81,
      "text": "曖昧匂いも あの時と同じで"
    },
    {
      "start": 93.81,
      "end": 101.05,
      "text": "この夜は急いそ抜かるでさ"
    },
    {
      "start": 101.05,
      "end": 105.15,
      "text": "ありがとう"
    },
    {
      "start": 115.69,
      "end": 119.69,
      "text": "しさもなにも 寄わせて"
    },
    {
      "start": 119.69,
      "end": 124.19,
      "text": "だましだましきてる"
    },
    {
      "start": 124.19,
      "end": 128.19,
      "text": "悪せくと忙しく"
    },
    {
      "start": 128.19,
      "end": 132.51,
      "text": "見せかけの優しさなんて"
    },
    {
      "start": 132.51,
      "end": 135.51,
      "text": "本当にいらない"
    },
    {
      "start": 135.51,
      "end": 139.77,
      "text": "あれこれと 映し出す"
    },
    {
      "start": 139.77,
      "end": 145.77,
      "text": "しらみ始めたの記憶も"
    },
    {
      "start": 145.77,
      "end": 151.02,
      "text": "ハニハニ 蜂蜜みたいな"
    },
    {
      "start": 151.02,
      "end": 157.24,
      "text": "汗を探しても 胸に残った"
    },
    {
      "start": 157.24,
      "end": 163.56,
      "text": "吐き誇りまま 会いたい匂いも"
    },
    {
      "start": 163.56,
      "end": 169.76,
      "text": "あの時と同じでも"
    },
    {
      "start": 169.76,
      "end": 174.46,
      "text": "この夜は急いそ下手歩い"
    },
    {
      "start": 174.46,
      "end": 195.16,
      "text": "ハニハニ 蜂蜜"
    },
    {
      "start": 195.16,
      "end": 200.69,
      "text": "窓のみにまみれても"
    },
    {
      "start": 200.69,
      "end": 205.69,
      "text": "肌に残った 針がチクチクしてる"
    },
    {
      "start": 205.69,
      "end": 214.58,
      "text": "曖昧匂いも あの時と同じで"
    },
    {
      "start": 214.58,
      "end": 221.23,
      "text": "この夜は一人知って"
    },
    {
      "start": 221.23,
      "end": 232.18,
      "text": "ハニハニの日 幸せを探しても"
    },
    {
      "start": 232.18,
      "end": 237.54,
      "text": "胸に残った 箱には勝てないまま"
    },
    {
      "start": 237.54,
      "end": 241.7,
      "text": "会いたい心も"
    },
    {
      "start": 241.7,
      "end": 246.48,
      "text": "あの時と同じでも"
    },
    {
      "start": 246.48,
      "end": 253.24,
      "text": "この夜は急いそ下手歩いだけ"
    },
    {
      "start": 253.24,
      "end": 271.54,
      "text": "ハニハニ"
    },
    {
      "start": 271.54,
      "end": 277.38,
      "text": "どうもありがとうございました"
    },
    {
      "start": 277.38,
      "end": 279.38,
      "text": "セットランドにて申しますよろしくお願いします"
    },
    {
      "start": 279.38,
      "end": 286.35,
      "text": "さっきひばりさんが"
    },
    {
      "start": 286.35,
      "end": 288.35,
      "text": "今日のイベントタイトルブルーって言ったんですけど"
    },
    {
      "start": 288.35,
      "end": 296.51,
      "text": "お前ブルー要素ないじゃんって思いますよね皆さん"
    },
    {
      "start": 296.51,
      "end": 302.88,
      "text": "でもやっぱね 明らさまにブルーを来てくるっていうのが"
    },
    {
      "start": 302.88,
      "end": 310.49,
      "text": "やっぱ僕も結構いい大人なんですよ"
    },
    {
      "start": 310.49,
      "end": 316.47,
      "text": "こう見えてね アラフォーなんですけど"
    },
    {
      "start": 316.47,
      "end": 318.47,
      "text": "やっぱアラフォーともなると"
    },
    {
      "start": 318.47,
      "end": 325.29,
      "text": "隠れブルーを来てきました"
    },
    {
      "start": 325.29,
      "end": 327.64,
      "text": "見えますか皆さん"
    },
    {
      "start": 327.64,
      "end": 329.64,
      "text": "ちゃんと書いてますよカカさん"
    },
    {
      "start": 329.64,
      "end": 331.64,
      "text": "ブッキングマネージャーカカさん"
    },
    {
      "start": 331.64,
      "end": 334.06,
      "text": "ちゃんとブルー入れてきましたよ"
    },
    {
      "start": 334.06,
      "end": 336.82,
      "text": "電池は切れちゃいましたけどね"
    },
    {
      "start": 336.82,
      "end": 342.84,
      "text": "今日は頑張って歌っていきますよろしくお願いします"
    },
    {
      "start": 383.61,
      "end": 389.27,
      "text": "まま 都合のいい女のまま"
    },
    {
      "start": 389.27,
      "end": 393.27,
      "text": "あなたと朝を迎えられたらそれで"
    },
    {
      "start": 393.27,
      "end": 396.27,
      "text": "それだけでいいの"
    },
    {
      "start": 396.27,
      "end": 401.42,
      "text": "重ね塗りでお隠したコーヒー"
    },
    {
      "start": 401.42,
      "end": 410.06,
      "text": "本当はなしでも"
    },
    {
      "start": 410.06,
      "end": 413.06,
      "text": "酔えるコーヒーなのにね"
    },
    {
      "start": 413.06,
      "end": 417.12,
      "text": "厚毛症で詰ましたフェース"
    },
    {
      "start": 417.12,
      "end": 420.12,
      "text": "遊びの恋を演じてる"
    },
    {
      "start": 420.12,
      "end": 424.85,
      "text": "本当はなしでも"
    },
    {
      "start": 424.85,
      "end": 446.97,
      "text": "酔えるくはあなた宇宙を滑る"
    },
    {
      "start": 446.97,
      "end": 449.13,
      "text": "不安がよぎる"
    },
    {
      "start": 449.13,
      "end": 453.13,
      "text": "その右手や下が隠してる"
    },
    {
      "start": 453.13,
      "end": 456.13,
      "text": "この熱や湿りや痛みを"
    },
    {
      "start": 456.13,
      "end": 459.13,
      "text": "浴いてしまいそうで"
    },
    {
      "start": 459.13,
      "end": 464.31,
      "text": "重ね塗りでお隠したコーヒー"
    },
    {
      "start": 464.31,
      "end": 468.31,
      "text": "軽い女を演じてる"
    },
    {
      "start": 468.31,
      "end": 472.31,
      "text": "本当はなしでも"
    },
    {
      "start": 472.31,
      "end": 475.31,
      "text": "酔えるコーヒーなのにね"
    },
    {
      "start": 475.31,
      "end": 479.31,
      "text": "厚毛症で詰ましたフェース"
    },
    {
      "start": 479.31,
      "end": 483.31,
      "text": "遊びの恋を演じてる"
    },
    {
      "start": 483.31,
      "end": 487.31,
      "text": "本当はなしでも"
    },
    {
      "start": 487.31,
      "end": 492.31,
      "text": "酔えるくはあなた宇宙を滑る"
    },
    {
      "start": 492.31,
      "end": 498.84,
      "text": "不安がよぎる"
    },
    {
      "start": 524.38,
      "end": 525.38,
      "text": "どうもありがとう"
    },
    {
      "start": 525.38,
      "end": 582.58,
      "text": "チークという曲でした"
    },
    {
      "start": 582.58,
      "end": 586.7,
      "text": "失くしたと思っていた"
    },
    {
      "start": 586.7,
      "end": 589.7,
      "text": "地下ごろじゃ"
    },
    {
      "start": 589.7,
      "end": 596.94,
      "text": "見かけなくたったから"
    },
    {
      "start": 596.94,
      "end": 599.94,
      "text": "流した涙も"
    },
    {
      "start": 599.94,
      "end": 604.24,
      "text": "泣き聞いて"
    },
    {
      "start": 604.24,
      "end": 619.18,
      "text": "マジックワリと"
    },
    {
      "start": 619.18,
      "end": 623.1,
      "text": "散った瞬間"
    },
    {
      "start": 623.1,
      "end": 628.63,
      "text": "あの灰色の街を歩いて"
    },
    {
      "start": 628.63,
      "end": 639.6,
      "text": "時をまた逝って"
    },
    {
      "start": 639.6,
      "end": 647.87,
      "text": "傷つくのは怖いです"
    },
    {
      "start": 647.87,
      "end": 649.87,
      "text": "テクマザードン・カント・フォーキャクテンス"
    },
    {
      "start": 649.87,
      "end": 651.87,
      "text": "感情のマスタース迷いです"
    },
    {
      "start": 651.87,
      "end": 654.87,
      "text": "いつの間にか覚えてた"
    },
    {
      "start": 654.87,
      "end": 657.97,
      "text": "でも今日は変だな"
    },
    {
      "start": 657.97,
      "end": 659.97,
      "text": "忘れられないよ"
    },
    {
      "start": 659.97,
      "end": 663.67,
      "text": "きみつやさいさなりゅうし"
    },
    {
      "start": 663.67,
      "end": 666.67,
      "text": "生きるために捨て"
    },
    {
      "start": 666.67,
      "end": 669.7,
      "text": "吐いてたのに"
    },
    {
      "start": 669.7,
      "end": 672.66,
      "text": "サンタたったことさ"
    },
    {
      "start": 672.66,
      "end": 675.91,
      "text": "気づけなきまま"
    },
    {
      "start": 675.91,
      "end": 691.09,
      "text": "このために生きるなんて"
    },
    {
      "start": 691.09,
      "end": 693.09,
      "text": "だににもできやしたいのに"
    },
    {
      "start": 693.09,
      "end": 695.09,
      "text": "君のために生きてるフリで"
    },
    {
      "start": 695.09,
      "end": 696.09,
      "text": "追いつけて"
    },
    {
      "start": 696.09,
      "end": 698.09,
      "text": "傷つけた"
    },
    {
      "start": 700.5,
      "end": 731.57,
      "text": "しわくちゃな手紙を見返し"
    },
    {
      "start": 731.57,
      "end": 732.57,
      "text": "溢れた"
    },
    {
      "start": 732.57,
      "end": 735.57,
      "text": "殺したずの感情なくして"
    },
    {
      "start": 735.57,
      "end": 737.57,
      "text": "なんかいなかった"
    },
    {
      "start": 737.57,
      "end": 739.57,
      "text": "しひかりと今"
    },
    {
      "start": 739.57,
      "end": 741.57,
      "text": "受け取ったよ"
    },
    {
      "start": 741.57,
      "end": 744.57,
      "text": "吐いて捨てることしかできないなら"
    },
    {
      "start": 744.57,
      "end": 746.57,
      "text": "せめてこの二酸が"
    },
    {
      "start": 746.57,
      "end": 749.57,
      "text": "嘘は歌に変えて"
    },
    {
      "start": 749.57,
      "end": 753.71,
      "text": "歌うよ"
    },
    {
      "start": 753.71,
      "end": 760.7,
      "text": "見えないか"
    },
    {
      "start": 760.7,
      "end": 762.95,
      "text": "捨て捨てを"
    },
    {
      "start": 762.95,
      "end": 769.82,
      "text": "ティヒニーのせるよ"
    },
    {
      "start": 769.82,
      "end": 775.43,
      "text": "聞いても別れ聞いてても"
    },
    {
      "start": 775.43,
      "end": 800.39,
      "text": "歌うよ歌うよ歌うよ"
    },
    {
      "start": 800.39,
      "end": 810.3,
      "text": "ありがとうございます"
    },
    {
      "start": 810.3,
      "end": 812.3,
      "text": "CO2という曲を聴いていただきました"
    },
    {
      "start": 812.3,
      "end": 814.3,
      "text": "ありがとうございます"
    },
    {
      "start": 814.3,
      "end": 837.95,
      "text": "マイク立てて"
    },
    {
      "start": 837.95,
      "end": 839.95,
      "text": "ライブしたのすごい久しぶりで"
    },
    {
      "start": 839.95,
      "end": 841.95,
      "text": "めちゃくちゃ緊張する"
    },
    {
      "start": 841.95,
      "end": 844.56,
      "text": "すごいドキドキする"
    },
    {
      "start": 844.56,
      "end": 847.46,
      "text": "でもマイク"
    },
    {
      "start": 847.46,
      "end": 852.21,
      "text": "ぜひ拾う"
    },
    {
      "start": 852.21,
      "end": 854.21,
      "text": "アコギの音ってめちゃくちゃ良くないですか"
    },
    {
      "start": 854.21,
      "end": 856.21,
      "text": "俺めちゃくちゃ好きなんですよ"
    },
    {
      "start": 856.21,
      "end": 858.21,
      "text": "ただあの"
    },
    {
      "start": 858.21,
      "end": 860.21,
      "text": "マイキングが難しくてね"
    },
    {
      "start": 860.21,
      "end": 862.37,
      "text": "マイキングってこの"
    },
    {
      "start": 862.37,
      "end": 864.85,
      "text": "マイクに対するこの"
    },
    {
      "start": 864.85,
      "end": 866.85,
      "text": "音を発生するものの位置みたいな"
    },
    {
      "start": 866.85,
      "end": 868.85,
      "text": "ことだと思うんですけども"
    },
    {
      "start": 868.85,
      "end": 869.85,
      "text": "それがすごく難しくて"
    },
    {
      "start": 869.85,
      "end": 871.85,
      "text": "すごいドキドキしながら"
    },
    {
      "start": 871.85,
      "end": 873.85,
      "text": "歌わせてもらってますけども"
    },
    {
      "start": 873.85,
      "end": 875.85,
      "text": "気持ちいいですか"
    },
    {
      "start": 875.85,
      "end": 878.87,
      "text": "気持ち良かった"
    },
    {
      "start": 878.87,
      "end": 884.94,
      "text": "思い出しますよ"
    },
    {
      "start": 884.94,
      "end": 886.94,
      "text": "俺バンドマンなんですけど"
    },
    {
      "start": 886.94,
      "end": 889.77,
      "text": "ボーカル修行のために"
    },
    {
      "start": 889.77,
      "end": 891.93,
      "text": "クソ安い"
    },
    {
      "start": 891.93,
      "end": 894.93,
      "text": "3万くらいのアコギ"
    },
    {
      "start": 894.93,
      "end": 897.93,
      "text": "黒沢学期のオリジナルのアコギ"
    },
    {
      "start": 897.93,
      "end": 899.93,
      "text": "持って一人で"
    },
    {
      "start": 899.93,
      "end": 901.93,
      "text": "ステージに立ったときに"
    },
    {
      "start": 901.93,
      "end": 902.93,
      "text": "があるんですよ"
    },
    {
      "start": 902.93,
      "end": 903.93,
      "text": "その時"
    },
    {
      "start": 903.93,
      "end": 905.93,
      "text": "アコギってマイクで拾うもの"
    },
    {
      "start": 905.93,
      "end": 906.93,
      "text": "と思ってたんで"
    },
    {
      "start": 906.93,
      "end": 907.93,
      "text": "その時もマイクで拾って"
    },
    {
      "start": 907.93,
      "end": 909.93,
      "text": "ライブして"
    },
    {
      "start": 909.93,
      "end": 911.93,
      "text": "すげー難しくて"
    },
    {
      "start": 911.93,
      "end": 913.93,
      "text": "すげー緊張して"
    },
    {
      "start": 913.93,
      "end": 914.93,
      "text": "うまく歌えなかった"
    },
    {
      "start": 914.93,
      "end": 917.89,
      "text": "そんな苦い思い出があるけれども"
    },
    {
      "start": 917.89,
      "end": 919.89,
      "text": "そんなの思い出しますね"
    },
    {
      "start": 919.89,
      "end": 924.48,
      "text": "ひよりょはきっと"
    },
    {
      "start": 924.48,
      "end": 932.08,
      "text": "うまく歌えてるだろうだと思うけど"
    },
    {
      "start": 932.08,
      "end": 941.89,
      "text": "アンサーという曲を歌います"
    },
    {
      "start": 941.89,
      "end": 945.11,
      "text": "アンセーキチョーとの"
    },
    {
      "start": 945.11,
      "end": 954.99,
      "text": "旅で残る"
    },
    {
      "start": 954.99,
      "end": 960.23,
      "text": "母と"
    },
    {
      "start": 960.23,
      "end": 964.12,
      "text": "得たその"
    },
    {
      "start": 964.12,
      "end": 979.38,
      "text": "日も人も季節も"
    },
    {
      "start": 979.38,
      "end": 985.5,
      "text": "愛後に残った"
    },
    {
      "start": 985.5,
      "end": 987.5,
      "text": "それが"
    },
    {
      "start": 987.5,
      "end": 992.27,
      "text": "とった"
    },
    {
      "start": 992.27,
      "end": 1013.47,
      "text": "わそうの"
    },
    {
      "start": 1013.47,
      "end": 1323.18,
      "text": "いだわ"
    },
    {
      "start": 1323.18,
      "end": 1324.18,
      "text": "シモキタザはラグナ"
    },
    {
      "start": 1324.18,
      "end": 1335.56,
      "text": "楽しんでおりますか"
    },
    {
      "start": 1335.56,
      "end": 1337.56,
      "text": "次で最後の曲になります"
    },
    {
      "start": 1337.56,
      "end": 1338.59,
      "text": "今日ね"
    },
    {
      "start": 1338.59,
      "end": 1341.9,
      "text": "4組のアーティストさん"
    },
    {
      "start": 1341.9,
      "end": 1342.9,
      "text": "僕を含めず"
    },
    {
      "start": 1342.9,
      "end": 1345.32,
      "text": "3組のアーティストさんと僕で"
    },
    {
      "start": 1345.32,
      "end": 1347.32,
      "text": "4組でやらせていただきましたけどね"
    },
    {
      "start": 1349.18,
      "end": 1350.18,
      "text": "すごく"
    },
    {
      "start": 1350.18,
      "end": 1352.18,
      "text": "素敵なアーティストさんばっかりで"
    },
    {
      "start": 1352.18,
      "end": 1353.18,
      "text": "楽しい一日に"
    },
    {
      "start": 1353.18,
      "end": 1355.76,
      "text": "なりましたね"
    },
    {
      "start": 1355.76,
      "end": 1358.42,
      "text": "ね"
    },
    {
      "start": 1358.42,
      "end": 1359.42,
      "text": "ありがとうございました"
    },
    {
      "start": 1359.42,
      "end": 1360.42,
      "text": "今日出てくれた皆さん"
    },
    {
      "start": 1360.42,
      "end": 1379.9,
      "text": "もう一度大きな拍手をお願いします"
    },
    {
      "start": 1379.9,
      "end": 1380.9,
      "text": "僕ね最近ちょっと"
    },
    {
      "start": 1380.9,
      "end": 1386.76,
      "text": "原突き変えまして"
    },
    {
      "start": 1386.76,
      "end": 1390.14,
      "text": "今売ってないんですよね"
    },
    {
      "start": 1390.14,
      "end": 1391.14,
      "text": "原突きってね"
    },
    {
      "start": 1391.14,
      "end": 1395.53,
      "text": "高校時代"
    },
    {
      "start": 1395.53,
      "end": 1396.53,
      "text": "ずっと原突き"
    },
    {
      "start": 1396.53,
      "end": 1398.88,
      "text": "大好きで乗ってて"
    },
    {
      "start": 1398.88,
      "end": 1401.04,
      "text": "原突きして乗れないんですけど"
    },
    {
      "start": 1401.04,
      "end": 1403.04,
      "text": "でもなんか自分で"
    },
    {
      "start": 1403.04,
      "end": 1404.71,
      "text": "いろいろ"
    },
    {
      "start": 1404.71,
      "end": 1406.71,
      "text": "エンジン分解して"
    },
    {
      "start": 1406.71,
      "end": 1408.71,
      "text": "掃除したりとかして"
    },
    {
      "start": 1408.71,
      "end": 1409.71,
      "text": "乗ってるうちにすごくね"
    },
    {
      "start": 1409.71,
      "end": 1412.13,
      "text": "わいちゃくわいてきてね"
    },
    {
      "start": 1412.13,
      "end": 1413.13,
      "text": "可愛いんですよ"
    },
    {
      "start": 1413.13,
      "end": 1416.78,
      "text": "50ccのバイクっていうの"
    },
    {
      "start": 1416.78,
      "end": 1418.78,
      "text": "高校時代にそんな感じで"
    },
    {
      "start": 1418.78,
      "end": 1420.78,
      "text": "本当はいけないんですけど"
    },
    {
      "start": 1420.78,
      "end": 1421.78,
      "text": "バイク乗りながら"
    },
    {
      "start": 1421.78,
      "end": 1426.6,
      "text": "音楽聞いてた"
    },
    {
      "start": 1426.6,
      "end": 1429.65,
      "text": "その頃好きだった"
    },
    {
      "start": 1429.65,
      "end": 1431.65,
      "text": "バンドの曲を"
    },
    {
      "start": 1431.65,
      "end": 1433.51,
      "text": "聞きながらね"
    },
    {
      "start": 1433.51,
      "end": 1437.3,
      "text": "原突きをカットバしてるような"
    },
    {
      "start": 1437.3,
      "end": 1439.94,
      "text": "高校生だったんですけど"
    },
    {
      "start": 1439.94,
      "end": 1441.49,
      "text": "なんか"
    },
    {
      "start": 1441.49,
      "end": 1443.62,
      "text": "その頃の気持ちに戻りたくて"
    },
    {
      "start": 1443.62,
      "end": 1445.62,
      "text": "原突き最近乗って"
    },
    {
      "start": 1445.62,
      "end": 1447.62,
      "text": "で本当はいけないんですけどね"
    },
    {
      "start": 1447.62,
      "end": 1451.66,
      "text": "聞いたりもしてるんですけど"
    },
    {
      "start": 1451.66,
      "end": 1455.46,
      "text": "今日みたいに晴れた日に"
    },
    {
      "start": 1455.46,
      "end": 1459.18,
      "text": "懐かしい曲を流しながら"
    },
    {
      "start": 1459.18,
      "end": 1461.95,
      "text": "走ってたんですけど"
    },
    {
      "start": 1461.95,
      "end": 1470.73,
      "text": "なんか"
    },
    {
      "start": 1470.73,
      "end": 1473.62,
      "text": "めちゃくちゃいいんですよ"
    },
    {
      "start": 1473.62,
      "end": 1474.62,
      "text": "音楽"
    },
    {
      "start": 1474.62,
      "end": 1475.62,
      "text": "大人になると"
    },
    {
      "start": 1475.62,
      "end": 1476.62,
      "text": "聞けなくなるじゃないですか"
    },
    {
      "start": 1476.62,
      "end": 1477.69,
      "text": "わかんないですか"
    },
    {
      "start": 1477.69,
      "end": 1478.75,
      "text": "大好きですか"
    },
    {
      "start": 1478.75,
      "end": 1482.26,
      "text": "昔みたいな純粋な気持ちで"
    },
    {
      "start": 1482.26,
      "end": 1485.15,
      "text": "聞けなくなるじゃないですか"
    },
    {
      "start": 1485.15,
      "end": 1486.15,
      "text": "であの"
    },
    {
      "start": 1486.15,
      "end": 1491.9,
      "text": "あの時みたいにね"
    },
    {
      "start": 1491.9,
      "end": 1495.18,
      "text": "言葉だったり"
    },
    {
      "start": 1495.18,
      "end": 1497.75,
      "text": "ギターの一音だったり"
    },
    {
      "start": 1497.75,
      "end": 1499.75,
      "text": "そんなものに人生"
    },
    {
      "start": 1499.75,
      "end": 1502.14,
      "text": "黒わされたあの頃みたいに"
    },
    {
      "start": 1502.14,
      "end": 1504.26,
      "text": "ちょっとビットだけ"
    },
    {
      "start": 1504.26,
      "end": 1508.09,
      "text": "そんな気持ちを思い出せてね"
    },
    {
      "start": 1508.09,
      "end": 1510.15,
      "text": "最近楽しいですという話で"
    },
    {
      "start": 1510.15,
      "end": 1512.15,
      "text": "今日示させていただきます"
    },
    {
      "start": 1512.15,
      "end": 1513.15,
      "text": "ありがとうございました"
    },
    {
      "start": 1513.15,
      "end": 1514.15,
      "text": "セットランドリーでした"
    },
    {
      "start": 1514.15,
      "end": 1521.39,
      "text": "つもろと曲"
    },
    {
      "start": 1583.68,
      "end": 1584.68,
      "text": "遠ざかる"
    },
    {
      "start": 1584.68,
      "end": 1588.7,
      "text": "慣れた背中"
    },
    {
      "start": 1588.7,
      "end": 1623.53,
      "text": "見始まる"
    },
    {
      "start": 1623.53,
      "end": 1625.53,
      "text": "悲しくないことを悲しまないで"
    },
    {
      "start": 1625.53,
      "end": 1628.53,
      "text": "それはいつかの君が"
    },
    {
      "start": 1628.53,
      "end": 1631.53,
      "text": "眠れない夜に零した"
    },
    {
      "start": 1631.53,
      "end": 1633.53,
      "text": "涙でできた"
    },
    {
      "start": 1633.53,
      "end": 1637.53,
      "text": "透明な傘が"
    },
    {
      "start": 1637.53,
      "end": 1638.59,
      "text": "あるから"
    },
    {
      "start": 1638.59,
      "end": 1675.47,
      "text": "誰の手を取って"
    },
    {
      "start": 1675.47,
      "end": 1696.28,
      "text": "寂しがらないで"
    },
    {
      "start": 1696.28,
      "end": 1699.41,
      "text": "それはいつかのあなたが"
    },
    {
      "start": 1699.41,
      "end": 1701.41,
      "text": "眠れない夜に噛み締めた"
    },
    {
      "start": 1701.41,
      "end": 1704.41,
      "text": "悔しさでできた"
    },
    {
      "start": 1704.41,
      "end": 1706.41,
      "text": "分厚い"
    },
    {
      "start": 1706.41,
      "end": 1711.22,
      "text": "歩かさ"
    },
    {
      "start": 1711.22,
      "end": 1728.39,
      "text": "思い出を連れ"
    },
    {
      "start": 1728.39,
      "end": 1745.88,
      "text": "誰の手を取って"
    },
    {
      "start": 1745.88,
      "end": 1791.43,
      "text": "ことずっと"
    },
    {
      "start": 1791.43,
      "end": 1800.94,
      "text": "ありがとうございました"
    },
    {
      "start": 1800.94,
      "end": 1801.94,
      "text": "セットランドリーでした"
    },
    {
      "start": 1801.94,
      "end": 1813.02,
      "text": "ありがとう"
    }
  ]
}